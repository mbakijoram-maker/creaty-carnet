rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pas de mot de passe : tout navigateur qui ouvre le carnet (compte anonyme Firebase) peut lire et écrire.
    match /carnets/creaty {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(['data', 'version', 'maj_le', 'par'])
        && request.resource.data.data is bytes
        && request.resource.data.version is int;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
